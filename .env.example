# Copy to .env and adjust. Never commit the real .env.

# Required in production: openssl rand -hex 32
SECRET_KEY=change-me

# The editor's own database
EDITOR_DATABASE_PATH=/data/plasmid_editor.db

# Shared MoClo Library Tool databases. Leave unset to run standalone;
# the MoClo browsing and part-contribution features then hide themselves.
PARTS_DATABASE_PATH=/moclo/parts.db
MOCLO_DATABASE_PATH=/moclo/moclo.db

# Where the MoClo Library Tool is, so the editor can link to it (navigation
# bar, and the Golden Gate option on the Cloning page). Use "/" when MoClo is
# at the root of the same host, as it is in the suite. Leave unset to hide
# those links.
MOCLO_BASE_URL=https://moclo.example.org

# Set false to close self-registration once the lab has accounts
ALLOW_REGISTRATION=true

# Pre-filled lab name on new accounts and contributed parts
DEFAULT_LAB_SOURCE=Gardiner Lab

# Creates the first admin account on an empty database
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
